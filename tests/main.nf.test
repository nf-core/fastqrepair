nextflow_pipeline {

    name "Test fastqrepair pipeline"
    script "../main.nf"

    tag "pipeline"
    tag "fastqrepair"

    test("30 paired-end reads, two FASTQ are empty") {

        when {
            params {
                input                   = 'https://raw.githubusercontent.com/nf-core/test-datasets/fastqrepair/testdata/samplesheet_30reads.csv'
                outdir                  = "$outputDir"

                publish_all_tools       = true
                num_splits              = 2
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path("$outputDir/repaired").list(),
                    path("$outputDir/repaired/test_30reads_2.report"),
                    path("$outputDir/pipeline_info/nf_core_fastqrepair_software_mqc_versions.yml"),
                    file("$outputDir/QC/multiqc/multiqc_report.html").exists(),
                    file("$outputDir/QC/fastqc/test_30reads_2.fastqc.html").exists(),
                    ).match("30reads_final")
                },
                { assert path("$outputDir/repaired").list().size() == 2 },
                { assert new File("$outputDir/pipeline_info/nf_core_fastqrepair_software_mqc_versions.yml").exists() },
                { assert new File("$outputDir/repaired/test_30reads_2.fastq.gz").exists() },
                { assert new File("$outputDir/repaired/test_30reads_2.report").exists() },
                { assert new File("$outputDir/repaired/test_30reads_2.report").readLines()[0].contains("FASTQWIPER REPORT:") },
                { assert new File("$outputDir/repaired/test_30reads_2.report").readLines()[3].contains("96 (92.31%)") }
            )
        }
    }
}
